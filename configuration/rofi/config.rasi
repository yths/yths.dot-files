configuration {
    timeout {
        action: "kb-cancel";
        delay: 0;
    }
    filebrowser {
        directories-first:true;
        sorting-method: "name";
    }
    display-run: " ";
    display-window: "  ";
    window-format: "[{w}]  {c}   {t}";
    window-match-fields: "title,class,desktop";
}

@theme "theme"