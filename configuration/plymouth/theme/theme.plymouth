[Plymouth Theme]
Name=default
Description=Boot splash for the default preset.
ModuleName=script

[script]
Font=OverpassM Nerd Font 18
TitleFont=OverpassM Nerd Font 18
ImageDir=/usr/share/plymouth/themes/default
ScriptFile=/usr/share/plymouth/themes/default/theme.script
BackgroundStartColor=0x322f2f
BackgroundEndColor=0x322f2f
MonospaceFont=OverpassM Nerd Font 12
ConsoleLogTextColor=0xd5d1d1
ConsoleLogBackgroundColor=0x322f2f

[boot-up]
Title=Starting System ...
SubTitle=Keep your face always towards the sunshine, and shadow will fall behind you.

[shutdown]
Title=Stopping System...
SubTitle=Learn as if you will live forever, live like you will die tomorrow.

[reboot]
Title=Restarting System...
SubTitle=Nature does not hurry, yet everything is accomplished.

[updates]
Title=Installing Updates...
SubTitle=Do not turn off your computer!

[system-upgrade]
Title=Upgrading System...
SubTitle=Do not turn off your computer!

[firmware-upgrade]
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer!

[system-reset]
Title=Restarting System...
SubTitle=If you are going through hell, keep going.

