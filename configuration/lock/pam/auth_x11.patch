+/*! \brief Read and forget whatever is waiting on stdin, without blocking.
+ *
+ * Keys pressed while no prompt is on screen - during "Processing...", or under
+ * a message - still arrive on the pipe, and would otherwise open the next
+ * prompt as the start of its answer.
+ */
+void DiscardPendingInput(void) {
+  char discarded[64];
+  for (;;) {
+    struct timeval timeout = {0, 0};
+    fd_set set;
+    memset(&set, 0, sizeof(set));  // For clang-analyzer.
+    FD_ZERO(&set);
+    FD_SET(0, &set);
+    if (select(1, &set, NULL, NULL, &timeout) <= 0) {
+      break;
+    }
+    ssize_t nread = read(0, discarded, sizeof(discarded));
+    explicit_bzero(discarded, sizeof(discarded));
+    if (nread <= 0) {
+      break;
+    }
+  }
+}
+
+/*! \brief Keep a message on screen for its full time, ignoring the keyboard.
+ *
+ * Unlike WaitForKeypress, a key neither dismisses the message nor survives it.
+ */
+void HoldMessage(int seconds) {
+  struct timeval now;
+  gettimeofday(&now, NULL);
+  long long deadline =
+      (now.tv_sec + seconds) * 1000000LL + (long long)now.tv_usec;
+  int open = 1;  // Whether stdin can still deliver anything.
+  for (;;) {
+    gettimeofday(&now, NULL);
+    long long left =
+        deadline - (now.tv_sec * 1000000LL + (long long)now.tv_usec);
+    if (left <= 0) {
+      break;
+    }
+    struct timeval timeout;
+    timeout.tv_sec = left / 1000000;
+    timeout.tv_usec = left % 1000000;
+    fd_set set;
+    memset(&set, 0, sizeof(set));  // For clang-analyzer.
+    FD_ZERO(&set);
+    if (open) {
+      FD_SET(0, &set);
+    }
+    int nfds = select(open ? 1 : 0, open ? &set : NULL, NULL, NULL, &timeout);
+    if (nfds < 0) {
+      break;
+    }
+    if (nfds > 0) {
+      char discarded[64];
+      ssize_t nread = read(0, discarded, sizeof(discarded));
+      explicit_bzero(discarded, sizeof(discarded));
+      if (nread <= 0) {
+        // EOF or error: stop watching it, but still sit out the rest.
+        open = 0;
+      }
+    }
+  }
+}
